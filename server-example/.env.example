# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# Backend URL
BACKEND_URL=http://localhost:7000

# Gmail SMTP Configuration (Use Google App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_char_app_password

# AES-256 Secret (Must be exactly 32 characters)
ENCRYPTION_KEY=your_32_char_secret_key_here!!!!

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Server Port
PORT=7000

# Admin Secret Key
ADMIN_KEY=YourSecretKey@123
